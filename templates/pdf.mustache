<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
    {{#files}}
        <li class="nav-item" role="presentation">
            <button class="nav-link {{#isfirst}}active{{/isfirst}}" id="pills_{{pdfitemid}}_{{fileid}}"
                    data-toggle="pill"
                    data-target="#pdfjsiframe_{{pdfitemid}}_{{fileid}}"
                    type="button"
                    role="tab"
                    aria-controls="pills-home"
                    aria-selected="true">{{filename}}</button>
        </li>
    {{/files}}
</ul>
<div class="tab-content min-vh-100 embed-responsive embed-responsive-4by3" id="pills-tabContent">
    {{#files}}
        <iframe
                aria-labelledby="pills_{{pdfitemid}}_{{fileid}}"
                role="tabpanel"
                id="pdfjsiframe_{{pdfitemid}}_{{fileid}}"
                name="pdfjsiframe_{{pdfitemid}}_{{fileid}}"
                class="tab-pane fade embed-responsive-item {{#isfirst}}show active{{/isfirst}}"
                data-pdfitemid="{{pdfitemid}}"
                data-fileid="{{fileid}}"
                data-fileurl="{{fileurl}}"
                data-annotatedfileurl="{{annotatedfileurl}}"
                src="{{{pdfviewerurl}}}"
                loading="lazy"
        ></iframe>
    {{/files}}
</div>

{{#js}}
    require(['local_pdfjs/viewpdf'], function (viewpdf) {
    viewpdf.init("{{formwrapperid}}", '{{pdfitemid}}'), {{readonly}};
    });
{{/js}}
